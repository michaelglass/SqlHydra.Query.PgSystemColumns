<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- This branch builds against a SqlHydra that has BOTH halves of the work `xmin`
         needs, neither of which is released:

           * column contribution, from `ext/contribute-columns` (IContributeColumns,
             Column.Doc). This is the half that makes the column EXIST.
           * read-only columns, from `pg-system-columns` / upstream PR #149
             (the library honouring read-only when it builds INSERT and UPDATE). This is
             the half that keeps the column out of a statement.

         The two are separate branches on purpose: read-only-ness is a general fix (a
         GENERATED ALWAYS column cannot be inserted into at all today) and belongs in the
         library, while contribution is the extension point. Pack a tree that has both:

           dotnet pack src/SqlHydra.Query/SqlHydra.Query.fsproj -c Release
             -p:Version=4.2.0-seam.1 -o ../local-feed
           dotnet pack src/SqlHydra.Cli/SqlHydra.Cli.fsproj -c Release
             -p:Version=4.2.0-seam.1 -o ../local-feed

         Delete this source (and the NuGet.config, if the repo had none) once both halves
         are in a released SqlHydra. -->
    <add key="sqlhydra-seam-local" value="../local-feed" />
  </packageSources>
</configuration>
