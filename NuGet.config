<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- BRANCH ONLY. This branch builds against a SqlHydra that carries the column
         contribution seam (`IContributeColumns`, `ColumnContributionContext`, `Column.Doc`)
         from the `ext/contribute-columns` branch. None of it is in the released 5.0.0, so
         it has to come from a locally packed tree:

           dotnet pack src/SqlHydra.Query/SqlHydra.Query.fsproj -c Release \
             -p:Version=5.1.0-seam.1 -o ../local-feed
           dotnet pack src/SqlHydra.Cli/SqlHydra.Cli.fsproj -c Release \
             -p:Version=5.1.0-seam.1 -o ../local-feed

         `SqlHydra.Query` bundles `SqlHydra.Domain.dll`, which is where the seam's types
         live, so referencing the query package is how this package sees them.

         Delete this file, and put the fsproj's floor back to a stable release, once the
         seam ships. -->
    <add key="sqlhydra-seam-local" value="../local-feed" />
  </packageSources>
</configuration>
