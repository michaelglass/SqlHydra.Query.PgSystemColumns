<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <WarnOn>3390;1104;0020;0044;0025;3391;0067;0021;1182</WarnOn>
    <NoWarn>$(NoWarn);NU1605;MSB3277;NETSDK1188</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>SqlHydra.Query.PgSystemColumns</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Michael Glass</Authors>
    <Description>PostgreSQL system columns (xmin) inside the SqlHydra.Query computation expression</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/michaelglass/SqlHydra.Query.PgSystemColumns</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>F# fsharp sql sqlhydra postgresql xmin system-columns optimistic-concurrency</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <!-- SourceLink stamps the published package with the commit it was built from, so a
         consumer can step into this source. The non-colocated-jj guard that keeps a local
         build working without a `.git` directory lives in the root Directory.Build.props. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
    <!-- BRANCH ONLY: a prerelease floor drags every consumer onto a prerelease of the
         host library, so this must go back to a stable version before release. It points at
         a locally packed SqlHydra carrying both unreleased halves (see NuGet.config):
         `IContributeColumns` and `Column.Doc` from the contribution seam, and
         `Column.ReadOnly` from the read-only work. None exist in 4.1.1. SelectQueryIR,
         SelectColumn and SelectBuilder remain the query-side surface. -->
    <PackageReference Include="SqlHydra.Query" Version="4.2.0-seam.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="SystemColumns.fs" />
    <Compile Include="Codegen.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Per-TFM FSharp.Core floors, lowest each TFM supports (mirroring SqlHydra.Query's).
         Left implicit, the F# SDK floats this to whatever the build SDK bundles — a
         non-deterministic, needlessly high floor that breaks consumers pinned lower. -->
    <PackageReference Update="FSharp.Core" Version="6.0.7" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Update="FSharp.Core" Version="8.0.100" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Update="FSharp.Core" Version="9.0.201" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Update="FSharp.Core" Version="10.1.201" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>
</Project>
